# Copy this file to .env for local dev (Docker Compose reads it automatically).
# Never commit the real .env — it's gitignored.

# Server port (Railway sets this automatically in production)
PORT=4000

# Writable directory for user-submitted data (newsletter/contact/applications).
# In production this MUST point at a mounted volume — see README.
DATA_DIR=./data

# Restricts CORS to this origin in production. Leave unset locally.
# FRONTEND_URL=https://your-frontend-domain.example.com

# Required to access the admin-only endpoints (/api/contact/messages,
# /api/newsletter/subscribers, /api/careers/applications). Without this set,
# those endpoints return 503 rather than being open — generate a long random
# value, e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=

# Optional — email notification on new contact/newsletter/application
# submissions. All four must be set for notifications to fire; if any are
# missing, the feature is silently disabled (submissions still succeed).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
