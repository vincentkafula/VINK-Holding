# Backend — Node/Express API
#
# Named Dockerfile.local (not Dockerfile) on purpose: this project deploys on
# Railway via Railpack (buildCommand/startCommand in Railway's service config),
# not Docker. A file literally named "Dockerfile" gets auto-detected and used
# by Railway's build step even when the service config says otherwise, which
# broke the frontend service in production — see git history. This file is
# for local `docker compose up` only.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY . .

# Writable volume mount point for user-submitted data in production —
# matches DATA_DIR in docker-compose.yml / Railway. The content/ directory
# ships with the image regardless.
RUN mkdir -p /data

EXPOSE 4000
CMD ["node", "server.js"]
